<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rag.api.infrastructure.persistence.mapper.SysToolMapper">

    <sql id="columns">id, code, name, fn_name, description, requires_key, sort, status, created_at, updated_at</sql>

    <select id="selectListByStatus" resultType="com.rag.api.infrastructure.persistence.entity.SysToolEntity">
        SELECT <include refid="columns"/> FROM sys_tool
        <where>
            <if test="status != null">status = #{status}</if>
        </where>
        ORDER BY sort ASC
    </select>
</mapper>
