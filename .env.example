# ============================================================
# RAG 平台环境配置（rag-api / rag-worker 启动时自动读取）
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 排除，勿提交真实密钥。
# 优先级：OS 环境变量 > .env > application.yml 默认值。
# 注意：按 properties 格式解析，Windows 路径请用正斜杠（如 D:/develop/...）。
# ============================================================

# ---------- 中间件公共地址 ----------
# MySQL 之外的 Redis / RabbitMQ / ES / MinIO / Milvus / etcd 默认共用该主机
MIDDLEWARE_HOST=192.168.1.200

# ---------- MySQL ----------
MYSQL_HOST=192.168.1.200
MYSQL_PORT=3306
MYSQL_DB=rag
MYSQL_USER=root
MYSQL_PASSWORD=rag123456

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- RabbitMQ（Worker 必需，compose 不含，需自备） ----------
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---------- Elasticsearch ----------
ES_PORT=9200
# 中文二元分词（修改后需删除旧索引并重建文档索引）
RAG_ES_ANALYZER=cjk

# ---------- MinIO ----------
MINIO_PORT=9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
MINIO_BUCKET=rag-files

# ---------- Milvus ----------
MILVUS_PORT=19530
# 维度不一致时是否允许自动删除"已确认空"的集合重建（默认 false，开启需留审计日志）
MILVUS_ALLOW_AUTO_RECREATE=false

# ---------- etcd ----------
ETCD_PORT=2379

# ---------- rag-api ----------
# JWT 签名密钥，生产必须修改
RAG_JWT_SECRET=K8vQ2mN7xR4pT9zL6wH3cF5jY1sD8aB0eU7nG2qM
# Query 改写 / Multi-Query（仅多轮对话触发，失败回退原始 Query）
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MAX_QUERIES=3
RAG_QUERY_REWRITE_TIMEOUT=8
# Agentic 工具编排最大推理轮次
RAG_AGENTIC_MAX_ROUNDS=3

# ---------- rag-worker ----------
# ffmpeg 可执行文件路径（视频转 HLS；ffprobe 取同目录），正斜杠写法
FFMPEG_PATH=D:/develop/ffmpeg/ffmpeg-7.1/bin/ffmpeg.exe
# 长视频并行转码段数（弱显卡/多任务并存可调为 1 或 2）
TRANSCODE_PARALLEL=3
# Tesseract 训练数据目录（留空则 OCR 降级跳过）
RAG_OCR_TESSDATA=
RAG_OCR_LANGS=chi_sim+eng
